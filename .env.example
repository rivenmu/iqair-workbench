# ============================================
# IQAir Workbench Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Django
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=*

# Database (MySQL 8.0)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=iqair_workbench
MYSQL_USER=iqair
MYSQL_PASSWORD=iqairpassword

# Redis
REDIS_PASSWORD=redispassword

# CSRF (comma-separated origins)
CSRF_TRUSTED_ORIGINS=http://localhost:8888,http://localhost:8000

# Celery
CELERY_WORKERS=2

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=IQAir Workbench

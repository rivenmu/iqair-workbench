# ============ 数据库配置 ============
MYSQL_ROOT_PASSWORD=change_this_to_strong_password
MYSQL_DATABASE=iqair_workbench
MYSQL_USER=iqair
MYSQL_PASSWORD=change_this_to_strong_password

# ============ Redis 配置 ============
REDIS_PASSWORD=change_this_to_strong_password

# ============ Django 配置 ============
DJANGO_SECRET_KEY=change_this_to_a_random_secret_key_in_production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:8888

# ============ 前端配置 ============
VITE_API_BASE_URL=https://your-domain.com
VITE_APP_TITLE=IQAir 数据分析工作台
